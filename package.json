{
  "name": "@srinivas-dev/safe-log",
  "version": "0.1.0",
  "description": "A high-performance, TypeScript-first library that prevents sensitive information from being exposed in application logs.",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "logging",
    "sanitize",
    "redact",
    "security",
    "pii",
    "winston",
    "pino"
  ],
  "license": "MIT",
  "author": "Srinivasan",
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "test",
    "samples",
    "bench",
    "eslint.config.mjs",
    "tsconfig.json",
    "tsup.config.ts",
    "vitest.config.mts",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": false,
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx bench/run.ts",
    "samples": "tsx samples/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "pino": ">=8",
    "winston": ">=3"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    },
    "winston": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino": "^10.3.1",
    "prettier": "^3.9.6",
    "tinybench": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  }
}
